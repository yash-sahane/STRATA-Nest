# =========================================================================
# L-T-Connect NestJS — environment template (Phase 0)
# Copy to .env and fill in. Validated by packages/config (Zod) at boot.
# Mirrors the Django settings surface (CURRENT_SYSTEM_AUDIT.md §3) plus
# the new async/realtime/security knobs (TARGET_ARCHITECTURE_NESTJS.md).
# =========================================================================

NODE_ENV=development

# --- API process ---------------------------------------------------------
API_PORT=8000
API_GLOBAL_PREFIX=api/v1
# Comma-separated; mirrors CORS_ALLOWED_ORIGINS (cookies => credentials:true)
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Worker process ------------------------------------------------------
WORKER_PORT=8001

# --- Database (Prisma) ---------------------------------------------------
# Same Postgres as Django during the strangler phase (ADR-0010).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ltconnect?schema=public

# --- Redis (partitioned by logical DB — ADR-0007 / arch §13) -------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_SOCKET_DB=2

# --- Auth / JWT (cookie-based — ADR-0009) --------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900          # seconds (15 min — A§5.2)
JWT_REFRESH_TTL=604800      # seconds (7 days — A§5.2)
JWT_ACCESS_COOKIE_NAME=lt_access
JWT_REFRESH_COOKIE_NAME=lt_refresh
JWT_COOKIE_DOMAIN=
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
# Refresh migration (PHASE_1_AUTH_PLAN §7): false = compatibility (accept valid
# Django-issued refresh tokens); true = strict (jti must exist in Redis).
AUTH_STRICT_REFRESH=false

# --- Email (Resend; queued via worker — ADR-0007) -----------------------
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# --- Storage (StorageService abstraction — arch §13) --------------------
STORAGE_DRIVER=local        # local | s3
STORAGE_LOCAL_ROOT=./.storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=

# --- Integration token encryption (closes D4) ---------------------------
# 32-byte key, base64 — used to encrypt GitHub/GitLab access tokens at rest.
INTEGRATION_TOKEN_ENC_KEY=

# --- Observability -------------------------------------------------------
LOG_LEVEL=info               # fatal|error|warn|info|debug|trace|silent

# --- Rate limiting (AUTH_SECURITY_CHECKLIST) — TTL seconds, limit req/TTL ---
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_DEFAULT_TTL=60
THROTTLE_LOGIN_LIMIT=5        # per IP
THROTTLE_LOGIN_TTL=60
THROTTLE_REFRESH_LIMIT=20     # per IP
THROTTLE_REFRESH_TTL=60
THROTTLE_REGISTER_LIMIT=3     # per IP
THROTTLE_REGISTER_TTL=3600
THROTTLE_RESET_LIMIT=3        # per IP + email
THROTTLE_RESET_TTL=3600

# --- Characterization / contract tests (ADR-0003, arch §19) -------------
# Base URL of the running legacy Django API to assert contract parity against.
DJANGO_API_URL=http://localhost:8000
