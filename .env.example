# =========================================================================
# STRATA — environment template
# Copy to .env and fill in. Validated by packages/config (Zod) at boot.
# =========================================================================

NODE_ENV=development

# --- API process ---------------------------------------------------------
API_PORT=8000
API_GLOBAL_PREFIX=api/v1
# Comma-separated; mirrors CORS_ALLOWED_ORIGINS (cookies => credentials:true)
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# The API schema at /api/docs: on in development, off in production unless true.
# SWAGGER_ENABLED=false

# --- Web app (apps/frontend) ------------------------------------------------
# apps/frontend/next.config.js loads THIS file for the web app too.
# Where browsers reach the API. NEXT_PUBLIC_ values are built into the page.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional. The realtime socket (default: the API URL as ws://), the theme a new
# visitor starts on (dark|light|system; default dark), and where the web app's own
# server routes reach the API when that differs from the browser's address.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000
# NEXT_PUBLIC_DEFAULT_THEME=dark
# API_INTERNAL_URL=http://api:8000


# --- Database (Prisma) ---------------------------------------------------
# Port 5433: that is where infra/docker/docker-compose.yml publishes Postgres, so it
# never collides with a Postgres installed on the host. Inside the compose network the
# API uses postgres:5432 instead — compose overrides this value for its own containers.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/strata?schema=public

# --- Redis (partitioned by logical DB) ----------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# --- Auth / JWT (cookie-based — ADR-0009) --------------------------------
# Two keys: access tokens are signed with the first, refresh tokens with the
# second. A leaked access key cannot then mint a session that renews itself.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=604800      # seconds (7 days)
JWT_ACCESS_COOKIE_NAME=strata_access
JWT_REFRESH_COOKIE_NAME=strata_refresh
JWT_COOKIE_DOMAIN=
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
# Failed sign-ins per ACCOUNT before it takes no more guesses from anywhere, and
# for how long (seconds). The per-address limit is THROTTLE_LOGIN_*. 0 = off.
AUTH_LOCKOUT_ATTEMPTS=10
AUTH_LOCKOUT_WINDOW=900
# RBAC_ENFORCED: true = per-permission role checks on writes (secure default);
# false = membership-only floor (rollback lever only).
RBAC_ENFORCED=true

# --- Email (Resend; queued via worker — ADR-0007) -----------------------
# No key: the worker only LOGS each message ("[log-only] invite → …"). That is the right
# setting for local work, and for the e2e suite — which otherwise asks the provider to
# mail a few hundred addresses that do not exist.
#
# With a key: EMAIL_FROM must be an address on a domain you have VERIFIED in Resend.
# The placeholder below can never be: the API treats it as "mail is not delivered" — it
# warns at start-up, hands a new account's temporary password to whoever created it
# instead of mailing it, and "forgot password" says no link was sent. The same happens
# for a real domain the provider refuses (the worker records the refusal; the API reads
# it within half a minute). The worker log (`pnpm stack:logs`) has the provider's words.
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
# queue (default): the worker sends. inline: the API only logs each mail — no worker needed.
# EMAIL_TRANSPORT=queue

# --- Storage (StorageService abstraction) ------------------------------
# Files are kept on the API's disk. `s3` is reserved, and refused at start-up:
# no S3 driver is built (StorageService).
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.storage

# --- Integration token encryption --------------------------------------
# 32-byte key, base64 — used to encrypt GitHub/GitLab access tokens at rest.
INTEGRATION_TOKEN_ENC_KEY=

# --- AI generation (frontend) -------------------------------------------
# Powers the "Generate with AI" action on the Requirements screen, served by
# apps/frontend/src/app/api/ai-generate/route.ts and read from this file. They are
# read ONLY on the server, so never give them the NEXT_PUBLIC_ prefix: Next.js
# inlines those into the client bundle (and the route does not read them).
# With neither key set the route answers 503 and the feature stays off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional fallback provider, tried when Gemini is absent or failing.
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HF_MAX_TOKENS=8192          # output budget for the Hugging Face fallback; a full plan needs ~5k
# HF_ENDPOINT=https://router.huggingface.co/v1/chat/completions

# --- Observability -------------------------------------------------------
LOG_LEVEL=info               # fatal|error|warn|info|debug|trace|silent

# --- Rate limiting (AUTH_SECURITY_CHECKLIST) — TTL seconds, limit req/TTL ---
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_DEFAULT_TTL=60
THROTTLE_LOGIN_LIMIT=5        # per IP
THROTTLE_LOGIN_TTL=60
THROTTLE_REFRESH_LIMIT=20     # per IP
THROTTLE_REFRESH_TTL=60
THROTTLE_RESET_LIMIT=3        # per IP + email
THROTTLE_RESET_TTL=3600
# Whose forwarding headers (X-Real-IP / X-Forwarded-For) are believed for the
# limits above. Comma-separated: addresses, CIDR ranges, `loopback`, or host
# names (looked up every 60s). Anything else is keyed on its own socket address,
# so a client cannot pick a fresh bucket per request. Empty = trust nobody.
# The compose stack sets `loopback,nginx` for the api service.
TRUSTED_PROXIES=loopback

# --- Database seed (packages/prisma/src/seed.ts) -----------------------
# SEED_ADMIN_EMAIL=admin@strata.local
# SEED_ADMIN_PASSWORD=ChangeMe123!
# One account per workspace role, for the e2e suite. On by default outside
# production; never created when NODE_ENV=production.
# SEED_TEST_ACCOUNTS=false
# SEED_TEST_PASSWORD=RolePass123!

# --- Contract tests ----------------------------------------------------
# Base URL of the running NestJS API to assert the frozen wire contract against.
CONTRACT_BASE_URL=http://localhost:8000
