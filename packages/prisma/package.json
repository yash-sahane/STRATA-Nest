{
  "name": "@strata/prisma",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "pull": "prisma db pull --schema=schema",
    "generate": "prisma generate --schema=schema",
    "validate": "prisma validate --schema=schema",
    "format": "prisma format --schema=schema",
    "seed": "ts-node src/seed.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "echo \"(no unit tests in @strata/prisma)\" && exit 0"
  },
  "prisma": {
    "seed": "ts-node src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "dotenv": "^16.4.5"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.4.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.0",
    "prisma": "^5.18.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
