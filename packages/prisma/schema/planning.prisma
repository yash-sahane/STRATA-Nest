// Planning entities (epics + sprints). `requirementId` (Epic) is a scalar id
// string (soft FK); the wire emits the raw id.

model Epic {
  id            String    @id
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  workspaceId   String    @map("workspace_id")
  projectId     String    @map("project_id")
  requirementId String    @default("") @map("requirement_id")
  hierarchyId   String    @map("hierarchy_id")
  name          String
  description   String    @default("")
  color         String    @default("")
  startDate     DateTime? @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  status        String    @default("TODO")
  progress      Int       @default(0)
  assignedTeam  String    @default("") @map("assigned_team")
  createdById   String    @map("created_by_id")
  createdByName String    @default("") @map("created_by_name")

  // Same reasoning as Task.hierarchyId — see
  // 20260912000000_task_epic_hierarchy_id_unique.
  @@unique([projectId, hierarchyId])
  @@map("epics_epic")
}

model Sprint {
  id                 String   @id
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  workspaceId        String   @map("workspace_id")
  projectId          String   @map("project_id")
  name               String
  goal               String   @default("")
  startDate          DateTime @map("start_date") @db.Date
  endDate            DateTime @map("end_date") @db.Date
  status             String   @default("PLANNING")
  retrospectiveNotes String   @default("") @map("retrospective_notes")
  createdById        String   @map("created_by_id")
  createdByName      String   @default("") @map("created_by_name")

  @@index([projectId, status])
  @@map("sprints_sprint")
}

model Retrospective {
  id               String   @id
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  sprintId         String   @map("sprint_id")
  workspaceId      String   @map("workspace_id")
  projectId        String   @map("project_id")
  wentWell         Json     @default("[]") @map("went_well")
  needsImprovement Json     @default("[]") @map("needs_improvement")
  actionItems      Json     @default("[]") @map("action_items")
  createdById      String   @map("created_by_id")

  @@map("sprints_retrospective")
}
