// STRATA Prisma schema.
//
// Domain models are organized across multiple schema files. Explicit @@map/@map
// annotations define the canonical physical table and column names.
// Application identifiers are 20-character string primary keys.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}
