// L-T-Connect Prisma schema (split-folder layout — arch §5).
//
// Models are mapped to the EXISTING Django tables (@@map/@map) so the NestJS
// stack reads/writes the same database during the strangler migration (ADR-0010).
// Identity stays a 20-char string PK (ADR-0002) — never regenerated.
//
// Phase 1 introduces identity.prisma (User + minimal Workspace/WorkspaceMember
// that auth reads). Later phases add their models per the Migration Order Matrix.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}
