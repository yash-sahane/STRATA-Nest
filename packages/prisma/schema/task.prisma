// Task domain (tasks app).
//
// Notes:
// - Soft FKs (sprintId/epicId/functionalRequirementId/parentTaskId) are scalar
//   id strings; JSON arrays (assigneeIds/assigneeNames/labels/blockedBy/blocks)
//   are stored as JSON to match the wire format.
// - `assigneeNames` is the server's: resolved from the user table whenever
//   `assigneeIds` is written, index-aligned with it. No client sends it.
// - A task's attachments are the files that name it (UploadedFile.taskId).
// - TaskComment has no workspace column of its own; access is scoped through
//   its parent Task in the services layer.

model Task {
  id                      String    @id
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  /// Internal only -- never sent to a client and never sent back. The conflict check
  /// is per field (`basedOn`); this is the token that makes it atomic, by letting the
  /// write be conditional on the row the check was run against. Deliberately not
  /// `updatedAt`, which also moves for writes no human made -- see the
  /// optimistic_locking_version migration.
  version                 Int       @default(0)
  workspaceId             String    @map("workspace_id")
  projectId               String    @map("project_id")
  hierarchyId             String    @map("hierarchy_id")
  sprintId                String    @default("") @map("sprint_id")
  epicId                  String    @default("") @map("epic_id")
  functionalRequirementId String    @default("") @map("functional_requirement_id")
  parentTaskId            String    @default("") @map("parent_task_id")
  title                   String
  description             String    @default("")
  status                  String    @default("BACKLOG")
  priority                String    @default("MEDIUM")
  // When the task last entered DONE. `updatedAt` is not a completion time — any
  // later edit moves it — so completion trends and burndowns must bucket on this.
  completedAt             DateTime? @map("completed_at")
  assigneeIds             Json      @default("[]") @map("assignee_ids")
  assigneeNames           Json      @default("[]") @map("assignee_names")
  /// Who last changed the assignees — the server stamps it, from the caller.
  assignedBy              String    @default("") @map("assigned_by")
  assignedByName          String    @default("") @map("assigned_by_name")
  createdById             String    @map("created_by_id")
  createdByName           String    @default("") @map("created_by_name")
  dueDate                 DateTime? @map("due_date")
  estimatedHours          Float?    @map("estimated_hours")
  labels                  Json      @default("[]")
  position                Float     @default(0)
  blockedBy               Json      @default("[]") @map("blocked_by")
  blocks                  Json      @default("[]")

  // The human-facing key of a task, minted by the server one past the highest
  // in use (apps/api/src/modules/generation/hierarchy-ids.ts): deleting a task
  // frees its number only if it was the highest. Unique per project: of two
  // creates that mint the same key at once, the second takes the next free one
  // (createWithFreeHierarchyId). See 20260912000000_task_epic_hierarchy_id_unique.
  @@unique([projectId, hierarchyId])
  @@index([projectId, status])
  @@index([sprintId])
  @@index([hierarchyId])
  // "Whose is it": ?assigneeId= and the per-person summary read the list.
  @@index([assigneeIds(ops: JsonbPathOps)], type: Gin)
  // Deadline reminders and the completion trend range over these.
  @@index([workspaceId, dueDate])
  @@index([workspaceId, completedAt])
  @@map("tasks_task")
}

model TaskComment {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  content   String
  mentions  Json     @default("[]")

  @@map("tasks_taskcomment")
}
