// Task domain (tasks app).
//
// Notes:
// - Soft FKs (sprintId/epicId/functionalRequirementId/parentTaskId) are scalar
//   id strings; JSON arrays (assigneeIds/assignedTo/watcherIds/labels/blockedBy/
//   blocks/attachments) are stored as JSON to match the wire format.
// - TaskComment and KanbanColumn have no workspace column of their own; access
//   is scoped through their parent Task / Project in the services layer.

model Task {
  id                      String    @id
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  /// Internal only -- never sent to a client and never sent back. The conflict check
  /// is per field (`basedOn`); this is the token that makes it atomic, by letting the
  /// write be conditional on the row the check was run against. Deliberately not
  /// `updatedAt`, which also moves for writes no human made -- see the
  /// optimistic_locking_version migration.
  version                 Int       @default(0)
  workspaceId             String    @map("workspace_id")
  projectId               String    @map("project_id")
  hierarchyId             String    @map("hierarchy_id")
  sprintId                String    @default("") @map("sprint_id")
  epicId                  String    @default("") @map("epic_id")
  functionalRequirementId String    @default("") @map("functional_requirement_id")
  parentTaskId            String    @default("") @map("parent_task_id")
  title                   String
  description             String    @default("")
  status                  String    @default("BACKLOG")
  priority                String    @default("MEDIUM")
  // When the task last entered DONE. `updatedAt` is not a completion time — any
  // later edit moves it — so completion trends and burndowns must bucket on this.
  completedAt             DateTime? @map("completed_at")
  assigneeIds             Json      @default("[]") @map("assignee_ids")
  assignedBy              String    @default("") @map("assigned_by")
  assignedByName          String    @default("") @map("assigned_by_name")
  assignedTo              Json      @default("[]") @map("assigned_to")
  assignedToNames         Json      @default("[]") @map("assigned_to_names")
  watcherIds              Json      @default("[]") @map("watcher_ids")
  createdById             String    @map("created_by_id")
  createdByName           String    @default("") @map("created_by_name")
  dueDate                 DateTime? @map("due_date")
  estimatedHours          Float?    @map("estimated_hours")
  actualHours             Float?    @map("actual_hours")
  labels                  Json      @default("[]")
  attachments             Json      @default("[]")
  customFields            Json      @default("{}") @map("custom_fields")
  position                Float     @default(0)
  blockedBy               Json      @default("[]") @map("blocked_by")
  blocks                  Json      @default("[]")

  @@index([projectId, status])
  @@index([sprintId])
  @@index([hierarchyId])
  // The human-facing key of a task: allocated client-side as COUNT+1, so a delete
  // frees a number the next create hands out again and two concurrent creates
  // read the same count. See 20260912000000_task_epic_hierarchy_id_unique.
  @@unique([projectId, hierarchyId])
  @@map("tasks_task")
}

model TaskComment {
  id          String   @id
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  taskId      String   @map("task_id")
  userId      String   @map("user_id")
  content     String
  mentions    Json     @default("[]")
  attachments Json     @default("[]")

  @@map("tasks_taskcomment")
}

model KanbanColumn {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  projectId String   @map("project_id")
  name      String
  status    String
  wipLimit  Int?     @map("wip_limit")
  position  Float    @default(0)
  color     String   @default("")

  @@map("tasks_kanbancolumn")
}

model Label {
  id          String   @id
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  workspaceId String   @map("workspace_id")
  projectId   String?  @map("project_id")
  name        String
  color       String
  description String   @default("")

  @@map("tasks_label")
}
