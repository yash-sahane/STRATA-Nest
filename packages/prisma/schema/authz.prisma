// Normalized RBAC tables.
//
// Not queried at runtime today: permissions resolve from the built-in
// role->permission map (in code) plus the WorkspaceRole.permissions JSON. These
// tables are the normalized end-state - enable them with a migration + a seed of
// the default map, then point the permission resolver at them.

model Permission {
  id          String           @id
  createdAt   DateTime         @default(now()) @map("created_at")
  key         String           @unique // e.g. "workspace:update"
  description String           @default("")
  rolePerms   RolePermission[]
  userPerms   UserPermission[]

  @@map("authz_permission")
}

model RolePermission {
  id           String     @id
  workspaceId  String?    @map("workspace_id") // null = built-in/global role
  role         String
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, role, permissionId])
  @@map("authz_role_permission")
}

model UserPermission {
  id           String     @id
  userId       String     @map("user_id")
  workspaceId  String?    @map("workspace_id")
  permissionId String     @map("permission_id")
  granted      Boolean    @default(true)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, permissionId])
  @@map("authz_user_permission")
}
