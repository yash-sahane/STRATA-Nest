// Identity models (users, workspaces, memberships).

model User {
  id              String    @id
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  password        String
  lastLogin       DateTime? @map("last_login")
  isSuperuser     Boolean   @default(false) @map("is_superuser")
  email           String    @unique
  name            String
  phone           String    @default("")
  avatar          String    @default("")
  role            String    @default("MEMBER")
  workspaceId     String    @default("") @map("workspace_id")
  status          String    @default("ACTIVE")
  hasTempPassword Boolean   @default(false) @map("has_temp_password")
  isAdminFlag     Boolean   @default(false) @map("is_admin_flag")
  isActive        Boolean   @default(true) @map("is_active")
  isStaff         Boolean   @default(false) @map("is_staff")

  @@map("accounts_user")
}
