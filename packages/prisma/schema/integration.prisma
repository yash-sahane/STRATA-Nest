// Integrations. One integration per provider per project (unique projectId).
// `accessToken` is stored ENCRYPTED at rest and is write-only on the wire (never
// serialized back). Commits are unique per (project, sha). These tables have no
// workspace column - access is scoped via the project->workspace relation.

model GitHubIntegration {
  id               String   @id
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  projectId        String   @unique @map("project_id")
  repoOwner        String   @map("repo_owner")
  repoName         String   @map("repo_name")
  accessToken      String   @map("access_token") // encrypted ciphertext
  webhookSecret    String   @default("") @map("webhook_secret")
  autoUpdateStatus Boolean  @default(false) @map("auto_update_status")
  enabledEvents    Json     @default("[]") @map("enabled_events")


  // Whether this credential has ever been shown to work, and when. All three
  // providers accepted a token without ever calling the provider, so a broken
  // integration was indistinguishable from a working one. Null means never
  // tested — a real state, not a missing value.
  lastTestedAt     DateTime? @map("last_tested_at")
  lastTestOk       Boolean?  @map("last_test_ok")
  lastTestError    String?   @map("last_test_error")

  @@map("integrations_githubintegration")
}

