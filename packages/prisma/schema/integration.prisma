model GitCommit {
  id            String   @id
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  projectId     String   @map("project_id")
  provider      String
  commitSha     String   @map("commit_sha")
  message       String
  author        String
  authorEmail   String   @map("author_email")
  timestamp     DateTime
  linkedTaskIds Json     @default("[]") @map("linked_task_ids")
  url           String

  @@unique([projectId, commitSha])
  @@map("integrations_gitcommit")
}
