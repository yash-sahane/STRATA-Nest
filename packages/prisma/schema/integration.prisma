  // integration was indistinguishable from a working one. Null means never
  // tested — a real state, not a missing value.
  lastTestedAt     DateTime? @map("last_tested_at")
  lastTestOk       Boolean?  @map("last_test_ok")
  lastTestError    String?   @map("last_test_error")

  @@map("integrations_gitlabintegration")
}

