// Activity. ActivityLog is an APPEND-ONLY audit trail (no update/delete
// surface), written server-side (AuditSubscriber, writeAuditRow).

model ActivityLog {
  id          String   @id
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  workspaceId String   @map("workspace_id")
  /// Who did it. Null for an act no account here did: a task moved by a commit
  /// whose author is not a member (the row keeps the commit's own name). The API
  /// answers it as '' (activityLogResponse), as v1 always has.
  userId      String?  @map("user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  changes     Json     @default("{}")
  metadata    Json     @default("{}")

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_activitylog")
}
