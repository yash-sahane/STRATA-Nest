// Requirements (requirements app).
//
// Notes:
// - Soft FKs (epicId/sprintId/clientRequirementId) are scalar id strings; the
//   wire emits raw ids.
// - `tags`/`linkedProjectIds` are CSV-serialized AS STRINGS to match the wire
//   contract; array normalization would be a v2 contract change.

model ClientRequirement {
  id            String   @id
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  /// Internal only -- never sent to a client and never sent back. The conflict check
  /// is per field (`basedOn`); this is the token that makes it atomic, by letting the
  /// write be conditional on the row the check was run against. Deliberately not
  /// `updatedAt`, which also moves for writes no human made -- see the
  /// optimistic_locking_version migration.
  version       Int      @default(0)
  workspaceId   String   @map("workspace_id")
  projectId     String   @map("project_id")
  title         String
  description   String   @default("")
  clientName    String   @default("") @map("client_name")
  priority      String   @default("MEDIUM")
  status        String   @default("DRAFT")
  attachments   Json     @default("[]")
  createdById   String   @map("created_by_id")
  createdByName String   @default("") @map("created_by_name")

  @@map("requirements_clientrequirement")
}

model FunctionalRequirement {
  id                  String   @id
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  /// Internal only -- never sent to a client and never sent back. The conflict check
  /// is per field (`basedOn`); this is the token that makes it atomic, by letting the
  /// write be conditional on the row the check was run against. Deliberately not
  /// `updatedAt`, which also moves for writes no human made -- see the
  /// optimistic_locking_version migration.
  version             Int      @default(0)
  workspaceId         String   @map("workspace_id")
  projectId           String   @map("project_id")
  hierarchyId         String   @map("hierarchy_id")
  epicId              String   @default("") @map("epic_id")
  sprintId            String   @default("") @map("sprint_id")
  clientRequirementId String   @default("") @map("client_requirement_id")
  parentRequirementId String   @default("") @map("parent_requirement_id")
  title               String
  description         String   @default("")
  type                String   @default("FUNCTIONAL")
  complexity          String   @default("MEDIUM")
  priority            String   @default("")
  status              String   @default("DRAFT")
  progress            Int      @default(0)
  reusable            Boolean  @default(false)
  assignedTo          Json     @default("[]") @map("assigned_to")
  assignedToNames     Json     @default("[]") @map("assigned_to_names")
  tags                String   @default("")
  linkedProjectIds    String   @default("") @map("linked_project_ids")
  createdById         String   @map("created_by_id")
  createdByName       String   @default("") @map("created_by_name")

  // Hierarchy ids are the human-facing key of an FR (they prefix every task id
  // and every deep link). They were allocated as COUNT+1, which repeats the
  // moment an FR is deleted and races between two concurrent creates, so the
  // same id could name two rows. Allocation is now server-side and retries on
  // this constraint (requirements.services.ts, generation.service.ts).
  @@unique([projectId, hierarchyId])
  @@index([projectId, epicId])
  @@index([hierarchyId])
  @@index([parentRequirementId])
  @@map("requirements_functionalrequirement")
}
