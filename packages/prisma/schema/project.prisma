// Project (`projects_project`). `startDate`/`endDate` serialize date-only on the
// wire. Indexed on (workspace, status). Who works on a project is the
// workspace's members; a project has no member list of its own.

model Project {
  id              String    @id
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  /// Internal only -- never sent to a client and never sent back. The conflict check
  /// is per field (`basedOn`); this is the token that makes it atomic, by letting the
  /// write be conditional on the row the check was run against. Deliberately not
  /// `updatedAt`, which also moves for writes no human made -- see the
  /// optimistic_locking_version migration.
  version         Int       @default(0)
  workspaceId     String    @map("workspace_id")
  name            String
  shortCode       String    @map("short_code")
  description     String    @default("")
  clientName      String    @default("") @map("client_name")
  status          String    @default("PLANNING")
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  ownerId         String    @map("owner_id")
  createdById     String    @map("created_by_id")
  createdByName   String    @default("") @map("created_by_name")

  // `short_code` prefixes every task hierarchy id in the project, so two
  // projects sharing one inside a workspace make those ids ambiguous.
  @@unique([workspaceId, shortCode])
  @@index([workspaceId, status])
  @@map("projects_project")
}
