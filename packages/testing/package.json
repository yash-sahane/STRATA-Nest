{
  "name": "@strata/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Shared test infrastructure — factories, builders, fixtures, auth/workspace helpers — so no module reinvents test utilities.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "echo \"(no unit tests in @strata/testing)\" && exit 0"
  },
  "dependencies": {
    "@strata/common": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
