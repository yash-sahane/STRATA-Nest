# syntax=docker/dockerfile:1
# STRATA API image (NestJS HTTP + WS). Multi-stage, pnpm workspace.
FROM node:20-alpine AS base
# tini = PID 1 init for correct SIGTERM propagation → graceful shutdown.
RUN corepack enable && apk add --no-cache tini
WORKDIR /repo

# --- deps: install with only manifests for better layer caching ---
FROM base AS deps
COPY package.json pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/common/package.json packages/common/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/prisma/package.json packages/prisma/package.json
RUN pnpm install

# --- build ---
FROM deps AS build
COPY . .
RUN pnpm --filter @strata/prisma run generate || echo "prisma generate skipped (no models yet)"
# Build the api and its workspace dependencies (shared, config, common, prisma)
# in dependency order. The "..." suffix includes the package's dependencies.
RUN pnpm --filter "@strata/api..." run build

# --- runtime (non-root) ---
FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /repo /repo
WORKDIR /repo/apps/api
# Local storage dir must be writable by the non-root user (prod normally uses S3).
RUN mkdir -p .storage && chown -R node:node .storage
USER node
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:8000/api/v1/health || exit 1
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/main.js"]
