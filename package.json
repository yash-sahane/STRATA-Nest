{
  "name": "strata",
  "version": "0.1.0",
  "private": true,
  "description": "STRATA — Next.js + NestJS + Prisma + PostgreSQL + Redis + BullMQ monorepo.",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "dev": "pnpm run build:packages && pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm run build:packages && pnpm -r run typecheck",
    "test": "pnpm run build:packages && pnpm -r run test",
    "test:contract": "pnpm --filter @strata/contract-tests run test",
    "test:e2e": "pnpm --filter @strata/e2e run test:e2e",
    "prisma:generate": "pnpm --filter @strata/prisma run generate",
    "prisma:validate": "pnpm --filter @strata/prisma run validate",
    "prisma:seed": "pnpm --filter @strata/prisma run seed",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d --wait postgres redis",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:migrate": "pnpm --filter @strata/prisma run migrate:deploy",
    "db:status": "pnpm --filter @strata/prisma run migrate:status",
    "db:seed": "pnpm --filter @strata/prisma run seed",
    "db:reset": "docker compose -f infra/docker/docker-compose.yml down --volumes && pnpm run db:up && pnpm run db:migrate && pnpm run db:seed",
    "stack:up": "docker compose -f infra/docker/docker-compose.yml up -d --build --wait",
    "stack:down": "docker compose -f infra/docker/docker-compose.yml down",
    "stack:logs": "docker compose -f infra/docker/docker-compose.yml logs -f --tail=100",
    "stack:ps": "docker compose -f infra/docker/docker-compose.yml ps",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.79",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "eslint": "^8.56.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "react-day-picker>date-fns": "4"
      }
    },
    "overrides": {
      "multer@<2.3.0": "^2.3.0",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "lodash@<4.18.0": "^4.18.0",
      "qs@<6.16.0": "^6.16.0",
      "body-parser@<1.20.6": "^1.20.6",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "js-yaml@<3.15.2": "^3.15.2",
      "postcss@<8.5.23": "^8.5.23",
      "nanoid@<3.3.18": "^3.3.18",
      "sharp@<0.35.4": "^0.35.4",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@<1.1.21": "^1.1.21",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "glob@>=10.2.0 <10.5.0": "^10.5.0",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "fast-uri@<3.1.8": "^3.1.8",
      "tmp@<0.2.6": "^0.2.6",
      "browserslist@<4.28.7": "^4.28.7",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "ajv@>=8.0.0 <8.18.0": "^8.18.0",
      "webpack@<5.104.1": "^5.104.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
