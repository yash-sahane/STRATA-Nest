{
  "name": "lt-connect",
  "version": "0.1.0",
  "private": true,
  "description": "L-T-Connect — NestJS monorepo (API + Worker). Strangler migration from Django (see TARGET_ARCHITECTURE_NESTJS.md).",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:contract": "turbo run test --filter=@lt/contract-tests",
    "prisma:pull": "pnpm --filter @lt/prisma run pull",
    "prisma:generate": "pnpm --filter @lt/prisma run generate",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4"
  }
}
