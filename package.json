{
  "name": "strata",
  "version": "0.1.0",
  "private": true,
  "description": "STRATA — Next.js + NestJS + Prisma + PostgreSQL + Redis + BullMQ monorepo.",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm --filter \"./packages/*\" run build && pnpm -r run typecheck",
    "test": "pnpm --filter \"./packages/*\" run build && pnpm -r run test",
    "test:contract": "pnpm --filter @strata/contract-tests run test",
    "test:e2e": "pnpm --filter @strata/e2e run test:e2e",
    "prisma:generate": "pnpm --filter @strata/prisma run generate",
    "prisma:seed": "pnpm --filter @strata/prisma run seed",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.79",
    "@types/node": "^20.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
